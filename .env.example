# Copy to .env.local and fill in. Never commit real secrets.

# Postgres connection. For the local sync script use the DIRECT connection
# (db.PROJECT.supabase.co:5432). For Vercel/serverless runtime use the
# Transaction POOLER string (port 6543) to avoid exhausting connections.
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"

# Supabase project URL + publishable key (safe for client-side reads under RLS).
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# IndexNow key for instant Bing/Yandex submission. Generate a hex string and
# place a matching public/<key>.txt file.
INDEXNOW_KEY=
